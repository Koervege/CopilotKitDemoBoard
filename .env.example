# Copy to .env.local and fill in. Read ONLY on the server (src/app/api/copilotkit).
# Never prefix these with NEXT_PUBLIC_ — that would ship them to the browser.

ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model ("provider/model"). Defaults to anthropic/claude-sonnet-5-5.
# Use a cheaper model for demos, e.g. anthropic/claude-haiku-5-5
# COPILOT_MODEL=anthropic/claude-sonnet-5-5

# Optional: opt out of CopilotKit's anonymous usage telemetry (on by default).
COPILOTKIT_TELEMETRY_DISABLED=true
